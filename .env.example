# Iran Carbon Black AI Platform — environment template
# Copy to .env and adjust for your on-premise deployment

COMPOSE_PROJECT_NAME=iran-carbon-black

# Network
TZ=Asia/Tehran

# PostgreSQL (primary OLTP + Timescale-ready)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=carbon_black
POSTGRES_USER=icb_admin
POSTGRES_PASSWORD=change_me_strong_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# MinIO (object storage / data lake)
MINIO_ROOT_USER=icb_minio
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_RAW=datalake-raw
MINIO_BUCKET_CURATED=datalake-curated
MINIO_BUCKET_MODELS=ml-models

# MQTT (IoT / OT edge)
MQTT_HOST=mosquitto
MQTT_PORT=1883

# Auth / JWT / Phase-4 hardening
JWT_SECRET=change_me_jwt_secret_min_32_chars_long!!
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
AUTH_2FA_ENABLED=true
AUTH_2FA_REQUIRED=false
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=10
REQUIRE_PASSWORD_COMPLEXITY=true
RATE_LIMIT_PER_MINUTE=120
NETWORK_ZONE=it

# SLA targets (SRS)
SLA_AVAILABILITY_TARGET=99.9
RTO_SECONDS=7200
RPO_SECONDS=3600
BACKUP_DIR=./backups

# Service URLs (internal Docker network)
AUTH_SERVICE_URL=http://auth:8001
INGESTION_SERVICE_URL=http://ingestion:8002
ENERGY_SERVICE_URL=http://energy:8003
SUPPLY_SERVICE_URL=http://supply:8004
QUALITY_SERVICE_URL=http://quality:8005
SALES_SERVICE_URL=http://sales:8006
FINANCE_SERVICE_URL=http://finance:8007
DEMAND_SERVICE_URL=http://demand:8008
INTEGRATION_SERVICE_URL=http://integration:8009
TRAINING_SERVICE_URL=http://training:8010
OPS_SERVICE_URL=http://ops:8011
MATURITY_SERVICE_URL=http://maturity:8012

# Observability
PROMETHEUS_RETENTION=30d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password

# App
LOG_LEVEL=INFO
ENVIRONMENT=development
API_GATEWAY_PORT=8080
