  "panels": [
    {
      "title": "Open maintenance alerts",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "TimescaleDB" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "TimescaleDB" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS open_alerts FROM energy.maintenance_alerts WHERE acknowledged = FALSE;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        }
      }
    },
    {
      "title": "Latest RUL by equipment (days)",
      "type": "table",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 0 },
      "datasource": { "type": "postgres", "uid": "TimescaleDB" },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (equipment_id) equipment_id, rul_days, failure_probability, alert_issued, predicted_at, model_version FROM energy.rul_predictions ORDER BY equipment_id, predicted_at DESC;",
          "refId": "A"
        }
      ]
    },
    {
      "title": "GEN-001 temperature (24h)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "postgres", "uid": "TimescaleDB" },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time AS \"time\", temperature FROM energy.sensor_readings WHERE equipment_id = 'GEN-001' AND time > NOW() - INTERVAL '24 hours' ORDER BY 1;",
          "refId": "A"
        }
      ]
    },
    {
      "title": "GEN-001 vibration Z (24h)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "postgres", "uid": "TimescaleDB" },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time AS \"time\", vibration_z FROM energy.sensor_readings WHERE equipment_id = 'GEN-001' AND time > NOW() - INTERVAL '24 hours' ORDER BY 1;",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Energy kWh by source (48h)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "postgres", "uid": "TimescaleDB" },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time AS \"time\", kwh, source FROM energy.energy_consumption WHERE time > NOW() - INTERVAL '48 hours' ORDER BY 1;",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Recent source decisions",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "postgres", "uid": "TimescaleDB" },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT decided_at, line_id, recommended_source, grid_cost_irr_per_kwh, generator_cost_irr_per_kwh, estimated_saving_irr, is_peak FROM energy.source_decisions ORDER BY decided_at DESC LIMIT 20;",
          "refId": "A"
        }
      ]
    }
