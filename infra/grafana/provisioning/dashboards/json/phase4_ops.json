{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "title": "Live availability %",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "TimescaleDB" },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT availability_pct FROM ops.sla_daily WHERE day = CURRENT_DATE;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 99.0 },
              { "color": "green", "value": 99.9 }
            ]
          }
        }
      }
    },
    {
      "title": "Mandatory training completions",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "postgres", "uid": "TimescaleDB" },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS completed FROM training.enrollments e JOIN training.courses c ON c.id=e.course_id WHERE c.is_mandatory AND e.status='completed';",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Security events (24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "postgres", "uid": "TimescaleDB" },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS events FROM platform.security_events WHERE created_at > NOW() - INTERVAL '24 hours';",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Backup runs",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "postgres", "uid": "TimescaleDB" },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS backups FROM ops.backup_runs WHERE status='success' AND started_at > NOW() - INTERVAL '7 days';",
          "refId": "A"
        }
      ]
    },
    {
      "title": "SLA daily history",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "postgres", "uid": "TimescaleDB" },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT day AS \"time\", availability_pct FROM ops.sla_daily ORDER BY 1;",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Recent security events",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "postgres", "uid": "TimescaleDB" },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT created_at, username, event_type, ip_address FROM platform.security_events ORDER BY created_at DESC LIMIT 30;",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Training enrollments",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "postgres", "uid": "TimescaleDB" },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.username, c.title, e.status, e.progress_pct, e.completed_at FROM training.enrollments e JOIN training.courses c ON c.id=e.course_id ORDER BY e.enrolled_at DESC LIMIT 40;",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Change requests",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "postgres", "uid": "TimescaleDB" },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT id, title, domain, status, impact_level, created_at FROM training.change_requests ORDER BY created_at DESC;",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["phase4", "sla", "security", "training"],
  "time": { "from": "now-7d", "to": "now" },
  "title": "Phase 4 — Security, SLA & Training",
  "uid": "icb-phase4-ops",
  "version": 1
}
